OPT_DIR=/opt
ZEEBE_OPT_DIR=${OPT_DIR}/zeebe
ZEEBE_BIN_DIR=${ZEEBE_OPT_DIR}/bin
ZEEBE_WORKING_DIR=${ZEEBE_OPT_DIR}

#Zeebe related environment variables
export ZEEBE_LOG_LEVEL=${ZEEBE_LOG_LEVEL:-info}
export CAMUNDA_DATA_SECONDARYSTORAGE_TYPE=${CAMUNDA_DATA_SECONDARYSTORAGE_TYPE:-none}
export CAMUNDA_SECURITY_AUTHENTICATION_UNPROTECTEDAPI=${CAMUNDA_SECURITY_AUTHENTICATION_UNPROTECTEDAPI:-true}
export CAMUNDA_SECURITY_AUTHORIZATIONS_ENABLED=${CAMUNDA_SECURITY_AUTHORIZATIONS_ENABLED:-false}

cd ${ZEEBE_WORKING_DIR}
exec ${ZEEBE_BIN_DIR}/broker
