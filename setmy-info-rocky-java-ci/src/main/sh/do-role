#!/bin/sh

# sudo rebuilds the environment, so do-install has no variables of the container.
# The container command writes the role down while it is still the jenkins user.
if [ -z "${SMI_JENKINS_ROLE}" ] && [ -r /tmp/smi-jenkins-role ]; then
    SMI_JENKINS_ROLE=$(cat /tmp/smi-jenkins-role)
fi

if [ "${SMI_JENKINS_ROLE}" = "node" ]; then
    echo "$SMI_JENKINS_ROLE"
else
    echo "controller"
fi

exit 0
